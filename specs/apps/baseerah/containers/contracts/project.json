{
  "name": "baseerah-contracts",
  "root": "specs/apps/baseerah/containers/contracts",
  "tags": ["type:lib", "lang:ts", "domain:baseerah"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @redocly/cli lint specs/apps/baseerah/containers/contracts/openapi.yaml"
      },
      "cache": true,
      "inputs": ["{projectRoot}/openapi.yaml"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p specs/apps/baseerah/containers/contracts/generated && npx @redocly/cli bundle specs/apps/baseerah/containers/contracts/openapi.yaml -o specs/apps/baseerah/containers/contracts/generated/openapi-bundled.yaml"
      },
      "cache": true,
      "inputs": ["{projectRoot}/openapi.yaml"],
      "outputs": ["{projectRoot}/generated/openapi-bundled.yaml"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project (OpenAPI contract spec only)'"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project (OpenAPI contract spec only)'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project (OpenAPI contract spec only)'"
      },
      "cache": true
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project (OpenAPI contract spec only)'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project (OpenAPI contract spec only)'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run baseerah-contracts:typecheck",
          "npx nx run baseerah-contracts:lint",
          "npx nx run baseerah-contracts:test:unit",
          "npx nx run baseerah-contracts:test:coverage",
          "npx nx run baseerah-contracts:test:specs"
        ],
        "parallel": false
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'deps:audit: no package dependencies to audit'"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'specs:behavior:coverage: no Gherkin behavior specs for this OpenAPI contract project (echo placeholder)'"
      }
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/apps/rhino-cli/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run baseerah-contracts:specs:structure-validation",
          "npx nx run baseerah-contracts:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/baseerah/containers/contracts/**"]
  }
}
