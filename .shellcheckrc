# ShellCheck configuration for ose-public
# Applies repo-wide: ShellCheck reads this file from the directory of each
# checked script and its parents, so the root copy governs every tracked .sh.

# Default shell dialect for scripts whose shebang does not pin one.
shell=bash

# Allow ShellCheck to follow `source`/`.`-included files for cross-file checks.
external-sources=true

# Severity gating is applied at the call site (CI job + Husky hook both run
# `shellcheck --severity=warning`); it is not an .shellcheckrc directive.
#
# No repo-wide rule disables are configured: the tracked script set is already
# clean at the warning-and-above threshold. Add any future disable here with an
# inline `# rationale:` comment explaining why the rule is waived repo-wide.
