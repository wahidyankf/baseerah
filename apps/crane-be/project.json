{
  "name": "crane-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/crane-be/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/crane-be/crane-be.fsproj -c Release -o apps/crane-be/dist"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-be.fsproj"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/crane-be/crane-be.fsproj --no-restore"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-be.fsproj"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "fantomas --check apps/crane-be/src",
          "dotnet fsharplint lint apps/crane-be/crane-be.fsproj --lint-config apps/crane-be/fsharplint.json",
          "dotnet tool restore && dotnet fsharp-analyzers --project apps/crane-be/crane-be.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-be.fsproj"]
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas apps/crane-be/src"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas --check apps/crane-be/src"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/crane-be/crane-be.fsproj"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/crane-be/crane-be.fsproj"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-be/tests/unit/crane-be-unit-tests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/crane-be.fsproj",
        "{workspaceRoot}/specs/apps/crane/behavior/crane-be/gherkin/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-be/tests/unit/crane-be-unit-tests.fsproj /p:CollectCoverage=true /p:Threshold=95 /p:ThresholdType=line \"/p:ExcludeByFile=**/Program.fs%2C**/Config.fs%2C**/NatsSubscriber.fs%2C**/RealMediaAdapter.fs%2C**/libs/fsharp-crane-core/**\""
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/crane-be.fsproj",
        "{workspaceRoot}/specs/apps/crane/behavior/crane-be/gherkin/**/*.feature"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-be/tests/integration/crane-be-integration-tests.fsproj"
      },
      "cache": false
    },
    "specs:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate coverage --shared-steps --exclude-dir messaging specs/apps/crane/behavior/crane-be/gherkin apps/crane-be"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/crane/behavior/crane-be/gherkin/**/*.feature", "{projectRoot}/src/**/*.fs"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    }
  },
  "tags": ["type:app", "platform:web", "lang:dotnet", "domain:crane"],
  "implicitDependencies": ["fsharp-crane-core"]
}
