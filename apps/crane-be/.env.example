# crane-be — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# OPTIONAL | u16 | TCP port the server listens on (default: 8300)
CRANE_BE_PORT=8300

# REQUIRED | string | NATS server URL for OrganicLever backend connection
CRANE_BE_ORGANICLEVER_NATS_URL=nats://localhost:4222

# REQUIRED | string | NATS server URL for OSE Application backend connection
CRANE_BE_OSE_APP_NATS_URL=nats://localhost:4223
