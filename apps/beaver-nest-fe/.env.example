# beaver-nest-fe — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# REQUIRED | url | base URL of beaver-nest-be, used to fetch the landing-page greeting
BEAVER_NEST_FE_API_BASE_URL=http://localhost:19320

# OPTIONAL | u16 | Next.js dev-server port (framework-reserved name; default: 19310)
# PORT=19310

# OPTIONAL | string | Next.js dev-server hostname (framework-reserved name; default: 0.0.0.0)
# HOSTNAME=0.0.0.0
