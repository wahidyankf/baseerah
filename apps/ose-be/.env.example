# ose-be — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# REQUIRED | string | PostgreSQL connection URL
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://ose_app:ose_app@localhost:5432/ose_app

# OPTIONAL | u16 | TCP port the server listens on (default: 8302)
OSE_BE_PORT=8302

# OPTIONAL | string | Comma-separated CORS origins or "*" to allow all (default: *)
OSE_BE_CORS_ORIGINS=*

# OPTIONAL | string | OpenRouter API key — placeholder only; never commit a real key
OSE_BE_OPENROUTER_API_KEY=

# OPTIONAL | string | OpenRouter model identifier (default: openrouter/auto)
OSE_BE_OPENROUTER_MODEL=openrouter/auto

# OPTIONAL | string | OpenRouter API base URL (default: https://openrouter.ai/api/v1)
OSE_BE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# REQUIRED | string | NATS server URL for messaging
OSE_BE_NATS_URL=nats://localhost:4222
