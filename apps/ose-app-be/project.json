{
  "name": "ose-app-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ose-app-be/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx openapi-generator-cli generate -i $(pwd)/specs/apps/ose/containers/contracts/generated/openapi-bundled.yaml -g fsharp-giraffe-server -o $(pwd)/apps/ose-app-be/generated-contracts --model-package OseAppBe.Contracts --global-property=models,modelDocs=false,apiDocs=false"
      },
      "dependsOn": ["ose-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/containers/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/generated-contracts"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj -c Release -o apps/ose-app-be/dist"
      },
      "dependsOn": ["codegen"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OseAppBe/OseAppBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OseAppBe/OseAppBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "fantomas --check apps/ose-app-be/src",
          "dotnet fsharplint lint apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj --lint-config apps/ose-app-be/fsharplint.json",
          "dotnet tool restore && dotnet fsharp-analyzers --project apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/OseAppBe/OseAppBe.fsproj"]
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas apps/ose-app-be/src"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas --check apps/ose-app-be/src"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet watch run --project apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/ose-app-be/src/OseAppBe/OseAppBe.fsproj"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/ose-app-be/tests/unit/OseAppBe.UnitTests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/src/OseAppBe/OseAppBe.fsproj"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/ose-app-be/tests/unit/OseAppBe.UnitTests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/src/OseAppBe/OseAppBe.fsproj"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/ose-app-be/scripts/run-integration.sh"
      },
      "cache": false
    },
    "specs:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate coverage --shared-steps --exclude-dir regulatory-source --exclude-dir internal-policy --exclude-dir gap-analysis --exclude-dir ai-orchestration --exclude-dir messaging specs/apps/ose/behavior/app-be/gherkin apps/ose-app-be"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/behavior/app-be/gherkin/**/*.feature", "{projectRoot}/src/**/*.fs"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    }
  },
  "tags": ["type:app", "platform:giraffe", "lang:fsharp", "domain:ose"],
  "implicitDependencies": ["ose-contracts", "rhino-cli"]
}
