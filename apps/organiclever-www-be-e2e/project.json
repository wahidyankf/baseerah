{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-www-be-e2e",
  "sourceRoot": "apps/organiclever-www-be-e2e/src",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint@latest .",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run organiclever-www-be-e2e:typecheck",
          "npx nx run organiclever-www-be-e2e:lint",
          "npx nx run organiclever-www-be-e2e:test:unit",
          "npx nx run organiclever-www-be-e2e:test:coverage",
          "npx nx run organiclever-www-be-e2e:test:specs"
        ],
        "parallel": false
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-www-be/gherkin/**/*.feature"
      ],
      "options": {
        "command": "npx bddgen && npx playwright test",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/organiclever-www-be-e2e"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/apps/rhino-cli/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-www-be-e2e:specs:structure-validation",
          "npx nx run organiclever-www-be-e2e:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:organiclever"]
}
