{
  "name": "rhino-cli-rs",
  "sourceRoot": "apps/rhino-cli-rs",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:rust", "domain:tooling"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --manifest-path apps/rhino-cli-rs/Cargo.toml && mkdir -p apps/rhino-cli-rs/dist && cp apps/rhino-cli-rs/target/release/rhino-cli apps/rhino-cli-rs/dist/rhino-cli"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/target"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --manifest-path apps/rhino-cli-rs/Cargo.toml"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --manifest-path apps/rhino-cli-rs/Cargo.toml --all-targets -- -D warnings"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --manifest-path apps/rhino-cli-rs/Cargo.toml --"
      }
    },
    "spec-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Phase 0 — spec-coverage stubbed; cucumber tests + validator land in Phase 1'"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/rhino/behavior/cli/gherkin/**/*.feature", "{projectRoot}/**/*.rs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/rhino-cli-rs/Cargo.toml --tests"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/tests/**/*.rs",
        "{workspaceRoot}/specs/apps/rhino/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo llvm-cov --manifest-path apps/rhino-cli-rs/Cargo.toml --lib --ignore-filename-regex '(cli\\.rs|main\\.rs)' --lcov --output-path apps/rhino-cli-rs/cover.out --fail-under-lines 90"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/src/**/*.rs",
        "{workspaceRoot}/specs/apps/rhino/**/*.feature"
      ],
      "outputs": ["{projectRoot}/cover.out"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/rhino-cli-rs/Cargo.toml --lib"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path apps/rhino-cli-rs/Cargo.toml --all-targets"
      }
    }
  }
}
