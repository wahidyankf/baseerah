# AyoKoding Web Environment Variables
# Copy this file to .env.local and configure as needed.

# Content directory override (default: apps/ayokoding-web/content inside the repo)
# AYOKODING_WEB_CONTENT_DIR=

# Set to "true" to include draft posts in the content listing
# AYOKODING_WEB_SHOW_DRAFTS=

# Next.js framework vars (default values work for local development)
# PORT=3101
# HOSTNAME=0.0.0.0
