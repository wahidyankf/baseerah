{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-www",
  "sourceRoot": "apps/ayokoding-www/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No codegen needed — ayokoding-www has no OpenAPI contract'",
        "cwd": "{projectRoot}"
      }
    },
    "generate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts",
        "cwd": "{projectRoot}"
      }
    },
    "validate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts --validate",
        "cwd": "{projectRoot}"
      }
    },
    "generate-search-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/features/search/shell/generate-search-data.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts && next dev --port 3101",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["generate-indexes", "generate-search-data"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start --port 3101",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint@latest --jsx-a11y-plugin .",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/specs/apps/ayokoding/**/*.feature"],
      "options": {
        "command": "npx vitest run --project unit --project unit-fe",
        "cwd": "{projectRoot}"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["ayokoding-cli:build"],
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-be/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-www/gherkin/**/*.feature"
      ],
      "options": {
        "commands": [
          "npx vitest run --project unit --project unit-fe --coverage && (cd ../../apps/rhino-cli && cargo run --release --quiet -- test-coverage validate apps/ayokoding-www/coverage/lcov.info 82)",
          "../../apps/ayokoding-cli/dist/ayokoding-cli links check --content content",
          "npx tsx src/scripts/generate-indexes.ts --validate"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: integration tier not used for this content app'",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "specs:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate coverage --shared-steps specs/apps/ayokoding/behavior/ayokoding-www/gherkin specs/apps/ayokoding/behavior/ayokoding-be/gherkin specs/apps/ayokoding/behavior/ayokoding-build-tools/gherkin apps/ayokoding-www"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-www/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-be/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-build-tools/gherkin/**/*.feature",
        "{projectRoot}/**/*.{ts,tsx}"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    }
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ayokoding"],
  "implicitDependencies": ["ayokoding-cli"]
}
