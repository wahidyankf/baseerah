{
  "name": "crane-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/crane-cli/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/crane-cli/crane-cli.fsproj -c Release -o apps/crane-cli/dist"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-cli.fsproj"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/crane-cli/crane-cli.fsproj --no-restore"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-cli.fsproj"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "fantomas --check apps/crane-cli/src",
          "dotnet fsharplint lint apps/crane-cli/crane-cli.fsproj --lint-config apps/crane-cli/fsharplint.json"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/crane-cli.fsproj"]
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas apps/crane-cli/src"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fantomas --check apps/crane-cli/src"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/crane-cli/crane-cli.fsproj --"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/crane-cli/crane-cli.fsproj -- --help"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-cli/tests/unit/crane-cli-unit-tests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/crane-cli.fsproj",
        "{workspaceRoot}/specs/apps/crane/behavior/crane-cli/gherkin/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-cli/tests/unit/crane-cli-unit-tests.fsproj /p:CollectCoverage=true /p:Threshold=95 /p:ThresholdType=line \"/p:ExcludeByFile=**/Adapters/In/CliAdapter.fs%2C**/Adapters/Out/PdfAdapter.fs%2C**/Adapters/Out/OcrAdapter.fs%2C**/Program.fs\""
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/crane-cli.fsproj",
        "{workspaceRoot}/specs/apps/crane/behavior/crane-cli/gherkin/**/*.feature"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/crane-cli/tests/integration/crane-cli-integration-tests.fsproj"
      },
      "cache": false
    },
    "spec-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- spec-coverage validate --shared-steps specs/apps/crane/behavior/crane-cli/gherkin apps/crane-cli"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/crane/behavior/crane-cli/gherkin/**/*.feature",
        "{projectRoot}/src/**/*.fs"
      ]
    }
  },
  "tags": ["type:app", "platform:cli", "lang:dotnet", "domain:crane"],
  "implicitDependencies": []
}
