{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-www-fe-e2e",
  "sourceRoot": "apps/ayokoding-www-fe-e2e/src",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint@latest .",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run ayokoding-www-fe-e2e:typecheck",
          "npx nx run ayokoding-www-fe-e2e:lint",
          "npx nx run ayokoding-www-fe-e2e:test:unit",
          "npx nx run ayokoding-www-fe-e2e:test:coverage"
        ],
        "parallel": false
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-www/gherkin/**/*.feature"],
      "options": {
        "command": "npx bddgen && npx playwright test",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/ayokoding-www-fe-e2e"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:ayokoding"],
  "implicitDependencies": ["ayokoding-www"]
}
