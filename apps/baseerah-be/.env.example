# baseerah-be — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# OPTIONAL | u16 | TCP port the server listens on (default: 19320)
BASEERAH_BE_PORT=19320

# OPTIONAL | string | Comma-separated CORS origins or "*" to allow all (default: *)
BASEERAH_BE_CORS_ORIGINS=*
