{
  "name": "baseerah-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/baseerah-be/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx openapi-generator-cli generate -i $(pwd)/specs/apps/baseerah/containers/contracts/generated/openapi-bundled.yaml -g fsharp-giraffe-server -o $(pwd)/apps/baseerah-be/generated-contracts --model-package BaseerahBe.Contracts --global-property=models,modelDocs=false,apiDocs=false"
      },
      "dependsOn": ["baseerah-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/baseerah/containers/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/generated-contracts"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj -c Release -o apps/baseerah-be/dist"
      },
      "dependsOn": ["codegen"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/BaseerahBe/BaseerahBe.fsproj",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/BaseerahBe/BaseerahBe.fsproj",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "lint": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "fantomas --check apps/baseerah-be/src",
          "dotnet tool restore && dotnet fsharplint lint apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj --lint-config apps/baseerah-be/fsharplint.json",
          "dotnet tool restore && dotnet fsharp-analyzers --project apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/BaseerahBe/BaseerahBe.fsproj"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet watch run --project apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj"
      }
    },
    "test:unit": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' apps/baseerah-be/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test apps/baseerah-be/tests/unit/BaseerahBe.UnitTests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/src/BaseerahBe/BaseerahBe.fsproj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/baseerah-be/tests/unit/BaseerahBe.UnitTests.fsproj /p:CollectCoverage=true /p:Threshold=90 /p:ThresholdType=line \"/p:ExcludeByFile=**/Program.fs\""
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/tests/unit/**/*.fs"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run baseerah-be:typecheck",
          "npx nx run baseerah-be:lint",
          "npx nx run baseerah-be:test:unit",
          "npx nx run baseerah-be:test:coverage",
          "npx nx run baseerah-be:test:specs"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck", "lint"],
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/baseerah-be/tests/integration/BaseerahBe.IntegrationTests.fsproj"
      },
      "cache": false
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs behavior-coverage validate --shared-steps specs/apps/baseerah/behavior/baseerah-be/gherkin apps/baseerah-be"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/baseerah/behavior/baseerah-be/gherkin/**/*.feature",
        "{projectRoot}/src/**/*.fs"
      ]
    },
    "specs:domain:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'specs:domain:coverage: no-op (baseerah is not in specs.domain-areas — no domain/** bounded-context features)'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list apps/baseerah-be/src/BaseerahBe/BaseerahBe.fsproj package --vulnerable"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for F#'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/apps/rhino-cli/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run baseerah-be:specs:structure-validation",
          "npx nx run baseerah-be:specs:behavior:coverage",
          "npx nx run baseerah-be:specs:domain:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/baseerah/behavior/baseerah-be/gherkin/**/*.feature"]
  },
  "tags": ["type:app", "platform:giraffe", "lang:fsharp", "domain:baseerah"],
  "implicitDependencies": ["baseerah-contracts", "rhino-cli"]
}
