{
  "name": "rhino-cli",
  "sourceRoot": "apps/rhino-cli",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:rust", "domain:tooling"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --manifest-path apps/rhino-cli/Cargo.toml && mkdir -p apps/rhino-cli/dist && cp apps/rhino-cli/target/release/rhino-cli apps/rhino-cli/dist/rhino-cli"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/target"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --manifest-path apps/rhino-cli/Cargo.toml"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path apps/rhino-cli/Cargo.toml"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --manifest-path apps/rhino-cli/Cargo.toml -- --check"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{projectRoot}/.rustfmt.toml", "{workspaceRoot}/.rustfmt.toml"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt --manifest-path apps/rhino-cli/Cargo.toml -- --check",
          "cargo clippy --manifest-path apps/rhino-cli/Cargo.toml --all-targets -- -D warnings"
        ],
        "parallel": false
      }
    },
    "deny:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash apps/rhino-cli/scripts/deny-check.sh"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/deny.toml",
        "{projectRoot}/scripts/deny-check.sh"
      ]
    },
    "msrv:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo hack --manifest-path apps/rhino-cli/Cargo.toml check --rust-version"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --manifest-path apps/rhino-cli/Cargo.toml --"
      }
    },
    "specs:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Phase 0 — specs:coverage stubbed; cucumber tests + validator land in Phase 1'"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/rhino/behavior/rhino-cli/gherkin/**/*.feature", "{projectRoot}/**/*.rs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/rhino-cli/Cargo.toml --tests"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/tests/**/*.rs",
        "{projectRoot}/tests/golden-master/**/*",
        "{workspaceRoot}/specs/apps/rhino/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo llvm-cov --manifest-path apps/rhino-cli/Cargo.toml --lib --ignore-filename-regex '(cli\\.rs|main\\.rs|internal/git\\.rs|commands/git_pre_commit\\.rs|commands/env_|commands/doctor\\.rs|application/git/pre_commit\\.rs|infrastructure/git/|application/doctor/tools\\.rs|application/doctor/fixer\\.rs|application/doctor/checker\\.rs|application/testcoverage/diff\\.rs|application/testcoverage/merge\\.rs|application/env/)' --lcov --output-path apps/rhino-cli/lcov.info --fail-under-lines 90"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/src/**/*.rs",
        "{workspaceRoot}/specs/apps/rhino/**/*.feature"
      ],
      "outputs": ["{projectRoot}/lcov.info"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/rhino-cli/Cargo.toml --lib"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path apps/rhino-cli/Cargo.toml --all-targets"
      }
    },
    "specs:adoption-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate adoption"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*.feature"]
    },
    "specs:tree-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate tree"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "specs:counts-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate counts"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "specs:links-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate links"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*.md"]
    },
    "specs:gherkin-cardinality-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs validate gherkin-cardinality"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/specs/**/*.feature"]
    },
    "naming:harness-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness validate naming"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.rs",
        "{workspaceRoot}/.claude/agents/**/*.md",
        "{workspaceRoot}/.opencode/agents/**/*.md"
      ]
    },
    "naming:workflows-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- workflows validate naming"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/repo-governance/workflows/**/*.md"]
    },
    "mermaid:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- md validate mermaid --max-depth=4 --exclude plans/done --exclude apps/ayokoding-www/content --exclude apps/ose-www/content --exclude apps/rhino-cli/tests/fixtures"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/**/*.md"]
    },
    "links:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- md validate links --exclude plans/done --exclude apps/ayokoding-www/content --exclude apps/ose-www/content"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/**/*.md"]
    },
    "headings:hierarchy-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- md validate heading-hierarchy"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/**/*.md"]
    },
    "governance:vendor-audit-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- repo-governance validate vendor repo-governance/"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.rs", "{workspaceRoot}/repo-governance/**/*.md"]
    },
    "cross-vendor:parity-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash apps/rhino-cli/scripts/validate-cross-vendor-parity.sh"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/scripts/validate-cross-vendor-parity.sh",
        "{workspaceRoot}/repo-governance/**/*.md",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/.claude/agents/**/*.md",
        "{workspaceRoot}/.opencode/agents/**/*.md"
      ]
    },
    "env:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- env validate"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.rs",
        "{workspaceRoot}/env-contract.yaml",
        "{workspaceRoot}/apps/**/.env.example",
        "{workspaceRoot}/apps/*/src/env.ts",
        "{workspaceRoot}/apps/*/src/**/*.rs"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    }
  }
}
