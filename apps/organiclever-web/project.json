{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-web",
  "sourceRoot": "apps/organiclever-web/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @hey-api/openapi-ts -i specs/apps/organiclever/containers/contracts/generated/openapi-bundled.yaml -o apps/organiclever-web/src/generated-contracts -s && git diff --exit-code -- apps/organiclever-web/src/generated-contracts/"
      },
      "dependsOn": ["organiclever-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/organiclever/containers/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/src/generated-contracts"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/gen-migrations.mjs && next dev --port 3200",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/gen-migrations.mjs && next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["codegen"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start --port 3200",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint@latest --jsx-a11y-plugin . && npx eslint .",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/oxlint.json",
        "{projectRoot}/eslint.config.mjs",
        "{projectRoot}/tsconfig.json"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/src/generated-contracts/**/*",
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-web/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/organiclever/ddd/bounded-contexts.yaml",
        "{workspaceRoot}/specs/apps/organiclever/ddd/ubiquitous-language/**/*.md"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "commands": [
          "(cd ../../apps/rhino-cli && cargo run --release --quiet -- specs bc organiclever)",
          "(cd ../../apps/rhino-cli && cargo run --release --quiet -- specs ul organiclever)",
          "node scripts/gen-migrations.mjs && npx vitest run --coverage && (cd ../../apps/rhino-cli && cargo run --release --quiet -- test-coverage validate apps/organiclever-web/coverage/lcov.info 74)"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/src/generated-contracts/**/*",
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-web/gherkin/**/*.feature"
      ],
      "options": {
        "command": "npx vitest run --project unit",
        "cwd": "{projectRoot}"
      },
      "dependsOn": []
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-web/gherkin/**/*.feature"],
      "options": {
        "command": "node scripts/gen-migrations.mjs && npx vitest run --project integration",
        "cwd": "{projectRoot}"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev -p 6006 --no-open",
        "cwd": "{projectRoot}"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npx storybook build -o storybook-static",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "spec-coverage": {
      "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs coverage --shared-steps specs/apps/organiclever/behavior/organiclever-web/gherkin apps/organiclever-web",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-web/gherkin/**/*.feature",
        "{projectRoot}/**/*.{ts,tsx}"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    }
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["organiclever-contracts", "web-ui"]
}
