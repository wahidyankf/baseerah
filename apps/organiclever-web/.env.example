# organiclever-web — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# OPTIONAL | string | Backend API base URL for health-check and API calls (default: unset)
# When unset, backend status page shows "Not configured".
# ORGANICLEVER_BE_URL=

# OPTIONAL | u16 | Next.js dev-server port (framework-reserved name; default: 3200)
# PORT=3200

# OPTIONAL | string | Next.js dev-server hostname (framework-reserved name; default: 0.0.0.0)
# HOSTNAME=0.0.0.0
