# beaver-nest-be — environment variable template
# Copy to .env.local for local development; never commit real secrets or host paths.

# OPTIONAL | IPv4 address | Local host listener address (default: 127.0.0.1)
BEAVER_NEST_BE_HTTP_LISTEN_ADDRESS=127.0.0.1

# OPTIONAL | u16 | Backend listener port (default: 19300; Nx dev overrides to 19320)
BEAVER_NEST_BE_HTTP_LISTEN_PORT=19300

# REQUIRED by the development wrapper | absolute directory | Developer-owned local SQLite directory
BEAVER_NEST_BE_DEVELOPMENT_DATA_DIRECTORY=

# OPTIONAL | absolute directory | SQLite directory (production default: /var/lib/beaver-nest)
BEAVER_NEST_BE_DATA_DIRECTORY=/var/lib/beaver-nest

# REQUIRED for the production Compose stack | absolute host directory | Durable SQLite bind source
BEAVER_NEST_BE_HOST_DATA_DIRECTORY=

# OPTIONAL | positive integer | SQLite busy timeout in milliseconds (default: 1000)
BEAVER_NEST_BE_SQLITE_BUSY_TIMEOUT_MILLISECONDS=1000

# REQUIRED for the production Compose stack | IPv4 address | Explicit host publication address
BEAVER_NEST_BE_VPN_HOST_IP=

# OPTIONAL | u16 | Production-facing host publication port (default: 19300)
BEAVER_NEST_BE_PUBLIC_PORT=19300

# REQUIRED for the production Compose stack | absolute host directory | Backup bind source
BEAVER_NEST_BE_BACKUP_DIRECTORY=
