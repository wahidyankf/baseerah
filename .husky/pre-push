#!/usr/bin/env sh
set -e

# Pre-push: spec + code-coverage gates, BDD spec validators, markdown lint,
# env-contract validation, and changed-path-gated governance validators.
# typecheck/lint/test:unit run in pre-commit (via test:quick) — NOT here.
# test:integration/test:e2e are CRON-only — NOT here.
# If pre-push times out, run the nx commands below manually to warm cache, then push again.
PARALLEL=$(( $(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4) - 1 ))
npx nx affected -t spec-coverage test-coverage validate:specs-adoption validate:specs-tree validate:specs-counts validate:specs-links --parallel="$PARALLEL"
npm run lint:md
npx nx run rhino-cli:validate:env

# Naming validators — scoped to pushes that touch the relevant trees.
# Upstream may be missing on first push of a branch; default to empty range in that case.
RANGE=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 && echo '@{u}..HEAD' || echo "")
if [ -n "$RANGE" ]; then
  CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || echo "")
  if echo "$CHANGED" | grep -qE '^(\.claude/agents/|\.opencode/agent/)'; then
    npx nx run rhino-cli:validate:naming-agents
  fi
  if echo "$CHANGED" | grep -qE '^repo-governance/workflows/'; then
    npx nx run rhino-cli:validate:naming-workflows
  fi
  if echo "$CHANGED" | grep -qE '^repo-governance/.*\.md$'; then
    npx nx run rhino-cli:validate:repo-governance-vendor-audit
  fi
  # Cross-vendor behavioral-parity gate: run when any of the parity-relevant surfaces change.
  if echo "$CHANGED" | grep -qE '^(repo-governance/.*\.md$|AGENTS\.md$|CLAUDE\.md$|\.claude/agents/|\.opencode/agents/)'; then
    npx nx run rhino-cli:validate:cross-vendor-parity
  fi
  # Harness binding-parity guard (deterministic, no agent): run when binding surfaces change.
  if echo "$CHANGED" | grep -qE '^(\.amazonq/|AGENTS\.md$|docs/reference/platform-bindings\.md$|\.claude/|\.opencode/|\.codex/|\.github/)'; then
    npm run validate:harness-bindings
  fi
fi
