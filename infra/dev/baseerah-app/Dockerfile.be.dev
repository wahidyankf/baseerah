FROM mcr.microsoft.com/dotnet/sdk:10.0

# curl is required by the compose healthcheck (the SDK image does not ship it).
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["dotnet", "watch", "run", "--project", "src/BaseerahBe/BaseerahBe.fsproj"]
